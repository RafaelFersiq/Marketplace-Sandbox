{
  "type": "record",
  "name": "CartEvent",
  "namespace": "com.marketplace.cart",
  "doc": "Schema for Shopping Cart business event emitted on cart modifications.",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique telemetry event identifier (UUID v4)"
    },
    {
      "name": "event_type",
      "type": "string",
      "doc": "Cart operation discriminator (CART_ITEM_ADDED, CART_ITEM_REMOVED, CART_QUANTITY_UPDATED, CART_CLEARED)"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Milliseconds since UTC Unix epoch"
    },
    {
      "name": "cart_id",
      "type": "string",
      "doc": "Unique active cart identifier (UUID v4)"
    },
    {
      "name": "user_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Authenticated user identifier (UUID v4 if logged in, null if guest)"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Web/App session tracking identifier (UUID v4)"
    },
    {
      "name": "product_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Catalog product target of change (UUID v4, null when CART_CLEARED)"
    },
    {
      "name": "quantity",
      "type": [
        "null",
        "int"
      ],
      "default": null,
      "doc": "Item quantity added, removed, or set (null when CART_CLEARED)"
    },
    {
      "name": "unit_price",
      "type": [
        "null",
        {
          "type": "bytes",
          "logicalType": "decimal",
          "precision": 18,
          "scale": 4
        }
      ],
      "default": null,
      "doc": "Monetary value represented as fixed-precision decimal (precision 18, scale 4)"
    },
    {
      "name": "cart_total_items",
      "type": "int",
      "doc": "Total count of items in cart post-event"
    },
    {
      "name": "cart_total_value",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 18,
        "scale": 4
      },
      "doc": "Monetary value represented as fixed-precision decimal (precision 18, scale 4)"
    }
  ]
}
